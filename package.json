{
  "name": "docops-monorepo",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "EADMan: docs-as-code platform where documentation never drifts from the code.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/worker"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "docops": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/cli/src/bin.ts",
    "dogfood": "npm run docops -- check --format text",
    "api": "node --experimental-strip-types --disable-warning=ExperimentalWarning apps/api/src/main.ts",
    "worker": "node --experimental-strip-types --disable-warning=ExperimentalWarning apps/worker/src/main.ts",
    "sync": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/cli/src/bin.ts sync",
    "docs:build": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/cli/src/bin.ts build --out .docops/site",
    "eval": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/ai/src/eval/cli.ts --dataset packages/ai/eval/datasets/acme-smoke.jsonl --docs examples/acme-payments/docs --provider mock",
    "ci": "npm run typecheck && npm test && npm run dogfood && npm run build",
    "demo": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/demo.mjs"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/unist": "^3.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
